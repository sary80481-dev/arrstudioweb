# ─── Firebase Web App (Project settings → General → Your apps) ───
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Firebase Admin (Project settings → Service accounts → Generate new private key) ───
FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# tempel private key dalam satu baris, "\n" tetap literal
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── App ───
# email yang otomatis jadi admin saat pertama kali mendaftar (pisahkan dengan koma)
ADMIN_EMAILS=you@studio.com

# ─── Discord OAuth (discord.com/developers/applications → OAuth2) ───
# Redirect URI yang didaftarkan: <APP_URL>/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# URL publik situs (opsional; default = origin request)
APP_URL=http://localhost:3000

# ─── Kit seal (ArrSeal) ───
# rahasia untuk kunci pembuka modul kit yang disegel. Buat sekali: node scripts/kit-seal-key.mjs --init
# JANGAN diganti setelah kit disegel & dibagikan (semua kit harus disegel ulang)
KIT_SEAL_SECRET=

# ─── Video & file kit (Vercel Blob, akses Public) ───
# Vercel → Storage → Create → Blob (Public) → Connect ke proyek ini.
# Vercel otomatis mengisi BLOB_STORE_ID + BLOB_WEBHOOK_PUBLIC_KEY (autentikasi OIDC, tanpa token).
# Untuk lokal: `pnpm dlx vercel env pull .env.local` (ikut membawa VERCEL_OIDC_TOKEN).
# Store lama yang memakai token tetap didukung lewat BLOB_READ_WRITE_TOKEN.
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=
BLOB_READ_WRITE_TOKEN=

# ─── Pembayaran (Midtrans Snap) ───
# dashboard.midtrans.com → Settings → Access Keys (pakai kunci Sandbox dulu)
# Notification URL (Settings → Payment): <APP_URL>/api/payments/midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# "true" setelah metode pembayaran Midtrans aktif; selama belum, tombol beli mengarah ke Discord
PAYMENTS_ENABLED=false
# sandbox / production dipilih otomatis dari key: "SB-Mid-..." = sandbox, "Mid-..." = production
