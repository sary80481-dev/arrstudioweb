# ─── Firebase Web App (Project settings → General → Your apps) ───
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Firebase Admin (Project settings → Service accounts → Generate new private key) ───
FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# tempel private key dalam satu baris, "\n" tetap literal
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── App ───
# email yang otomatis jadi admin saat pertama kali mendaftar (pisahkan dengan koma)
ADMIN_EMAILS=you@studio.com

# ─── Discord OAuth (discord.com/developers/applications → OAuth2) ───
# Redirect URI yang didaftarkan: <APP_URL>/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# URL publik situs (opsional; default = origin request)
APP_URL=http://localhost:3000
